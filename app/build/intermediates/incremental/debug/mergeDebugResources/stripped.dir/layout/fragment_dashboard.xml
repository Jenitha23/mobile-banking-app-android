<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Top bar -->

            <ImageView
                android:id="@+id/ivMenu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_menu"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/text_primary" />

            <ImageView
                android:id="@+id/ivNotifications"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="20dp"
                android:src="@drawable/ic_notifications"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/ivMenu"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Hello, Kasun"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivMenu" />

            <TextView
                android:id="@+id/tvGreetingSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good Morning!"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="2dp" />

            <!-- Balance card -->

            <View
                android:id="@+id/cardBalance"
                android:layout_width="368dp"
                android:layout_height="193dp"
                android:layout_marginTop="40dp"
                android:background="@drawable/bg_balance_card"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.076"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGreetingSub" />

            <TextView
                android:id="@+id/tvBalanceLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total Balance"
                android:textColor="@color/text_on_primary_muted"
                android:textSize="13sp"
                app:layout_constraintTop_toTopOf="@id/cardBalance"
                app:layout_constraintStart_toStartOf="@id/cardBalance"
                android:layout_marginTop="20dp"
                android:layout_marginStart="20dp" />

            <ImageView
                android:id="@+id/ivToggleBalance"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_visibility"
                app:tint="@color/text_on_primary_muted"
                app:layout_constraintTop_toTopOf="@id/tvBalanceLabel"
                app:layout_constraintBottom_toBottomOf="@id/tvBalanceLabel"
                app:layout_constraintEnd_toEndOf="@id/cardBalance"
                android:layout_marginEnd="20dp" />

            <TextView
                android:id="@+id/tvBalanceAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 125,750.00"
                android:textColor="@color/text_on_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/tvBalanceLabel"
                app:layout_constraintStart_toStartOf="@id/cardBalance"
                android:layout_marginTop="8dp"
                android:layout_marginStart="20dp" />

            <TextView
                android:id="@+id/tvAccountMasked"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Savings Account • •••• •••• •••• 1234"
                android:textColor="@color/text_on_primary_muted"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@id/cardBalance"
                app:layout_constraintStart_toStartOf="@id/cardBalance"
                android:layout_marginBottom="18dp"
                android:layout_marginStart="20dp" />

            <!-- Quick actions -->

            <TextView
                android:id="@+id/tvQuickActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="60dp"
                android:text="Quick Actions"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/cardBalance" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToTransfer"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_quick_action"
                android:text="Fund Transfer"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_swap"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="26dp"
                app:iconTint="@color/brand_primary"
                app:layout_constraintEnd_toStartOf="@id/btnPayBills"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvQuickActions"
                app:layout_constraintWidth_percent="0.46" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayBills"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:text="Pay Bills"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:background="@drawable/bg_quick_action"
                app:icon="@drawable/ic_receipt"
                app:iconTint="@color/brand_primary"
                app:iconGravity="top"
                app:iconSize="26dp"
                app:iconPadding="8dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toTopOf="@id/btnGoToTransfer"
                app:layout_constraintStart_toEndOf="@id/btnGoToTransfer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.46" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGoToHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_quick_action"
                android:text="Transaction History"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_history"
                app:iconGravity="top"
                app:iconPadding="8dp"
                app:iconSize="26dp"
                app:iconTint="@color/brand_primary"
                app:layout_constraintEnd_toStartOf="@id/btnMore"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnGoToTransfer"
                app:layout_constraintWidth_percent="0.46" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMore"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:text="More"
                android:textSize="12sp"
                android:textColor="@color/text_primary"
                android:textAllCaps="false"
                android:background="@drawable/bg_quick_action"
                app:icon="@drawable/ic_more"
                app:iconTint="@color/brand_primary"
                app:iconGravity="top"
                app:iconSize="26dp"
                app:iconPadding="8dp"
                app:cornerRadius="16dp"
                app:layout_constraintTop_toTopOf="@id/btnGoToHistory"
                app:layout_constraintStart_toEndOf="@id/btnGoToHistory"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintWidth_percent="0.46"
                android:layout_marginBottom="12dp" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:background="@color/bg_card"
        android:elevation="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_home"
                app:tint="@color/brand_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="11sp"
                android:textColor="@color/brand_primary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_card"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Accounts"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_swap"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Transfer"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_person"
                app:tint="@color/text_hint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="11sp"
                android:textColor="@color/text_hint"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>